# Server Configuration
PORT=3090

# Zetaris Networked Data Platform / Super MCP (Optional — falls back to deterministic in-situ Federated SQL Engine)
ZETARIS_API_URL=https://cloud.enterprise.zetaris.com/api/v1
ZETARIS_MCP_URL=http://127.0.0.1:10000/mcp
ZETARIS_API_KEY=

# Meterless Runtime & Outcome Metering (Optional — falls back to local H-MEM + Scout Intent + Outcome Ledger)
METERLESS_RUNTIME_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_APP_ID=leadproof-agent
METERLESS_MAX_TENANT_BUDGET_USD=5.00

# Optional NVIDIA Nemotron Reasoning Endpoint (OpenAI-compatible)
NVIDIA_NIM_API_KEY=
NVIDIA_NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
